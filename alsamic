#!/bin/bash

SOUNDS_DIR="/usr/local/share/alsamic"

get_status() {
    amixer get Capture | grep -o '\[on\]\|\[off\]' | head -1 | tr -d '[]'
}

case "$1" in
    status)
        status=$(get_status)
        echo "{\"text\": \"$status\", \"alt\": \"$status\", \"class\": \"$status\"}"
        ;;
    on)
        amixer set Capture cap
        aplay "$SOUNDS_DIR/unmute.wav"
        ;;
    off)
        amixer set Capture nocap
        aplay "$SOUNDS_DIR/mute.wav"
        ;;
    toggle)
        status=$(get_status)
        if [[ "$status" == "on" ]]; then
            amixer set Capture nocap
            aplay "$SOUNDS_DIR/mute.wav"
        else
            amixer set Capture cap
            aplay "$SOUNDS_DIR/unmute.wav"
        fi
        ;;
    *)
        echo "Usage: alsamic {on|off|toggle|status}"
        exit 1
        ;;
esac